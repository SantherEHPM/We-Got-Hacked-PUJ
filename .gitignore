# ============================================================
# .gitignore óptimo para Unity — repo "We-Got-Hacked-PUJ"
#
# Estructura del repo:
#   /  (raíz)          → sobras de Unity (Library, Logs, UserSettings...)
#   /UnityProject/     → proyecto Unity real (Assets, Packages, etc.)
#   /UnityProject/FMOD → proyecto FMOD Studio
#   /Imágenes, /Avaliações → documentos del repo
#
# Las carpetas generadas se ANCLAN con "/" inicial a rutas concretas
# para no atrapar por accidente carpetas legítimas dentro de Assets
# (p. ej. Assets/_UI/.../Logs/ que sí es contenido del juego).
# ============================================================

# ---------- Sobra en la RAÍZ del repo (proyecto Unity inválido, sin Assets) ----------
# Estas carpetas quedaron al apuntar Unity a la raíz por error; NO son el
# proyecto real (ese es /UnityProject/). Se ignoran para no versionar basura.
/Library/
/Logs/
/UserSettings/
/Temp/
/Obj/
/Build/
/Builds/
/ProjectSettings/
/Packages/

# ---------- Proyecto Unity real: carpetas generadas (siempre regenerables) ----------
/UnityProject/Library/
/UnityProject/Temp/
/UnityProject/Obj/
/UnityProject/Logs/
/UnityProject/UserSettings/
/UnityProject/Build/
/UnityProject/Builds/

# MemoryCaptures y Recordings: ocupan mucho y pueden contener datos sensibles
/UnityProject/[Mm]emoryCaptures/
/UnityProject/[Rr]ecordings/

# ---------- FMOD ----------
# Log del editor FMOD (raíz del proyecto Unity)
/UnityProject/fmod_editor.log

# Caché de FMOD Studio (siempre regenerable)
/UnityProject/FMOD/.cache/

# Bancos de audio .bank compilados desde FMOD Studio (~60MB).
# SE VERSIONAN A PROPÓSITO: el juego no arranca sin ellos al clonar el repo
# en otro equipo (no todo el mundo tiene FMOD Studio para recompilar).
# No volver a ignorar /UnityProject/FMOD/Build/.
# (Se mantiene ignorado solo el caché: /UnityProject/FMOD/.cache/)

# ---------- IDEs y editores ----------
.vs/
.vscode/
.idea/
.consulo/
ExportedObj/
.gradle/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Plugin autogenerated de JetBrains Rider dentro de Assets
/UnityProject/Assets/Plugins/Editor/JetBrains/

# ---------- Compilación y archivos generados ----------
sysinfo.txt
crashlytics-build.properties

# Builds empaquetadas (en cualquier parte del repo)
*.apk
*.aab
*.unitypackage
*.app

# Meta de archivos de debug que genera Unity
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---------- Addressables / StreamingAssets temporales de Android ----------
/UnityProject/Assets/AddressableAssetsData/*/*.bin*
/UnityProject/Assets/AddressableAssetsData/*/*.bin.meta
/UnityProject/Assets/StreamingAssets/aa.meta
/UnityProject/Assets/StreamingAssets/aa/

# ---------- Logs generados por herramientas (NO confundir con assets 'Logs') ----------
# Solo en raíz y carpetas de proyecto, nunca dentro de Assets.
/*.log
/UnityProject/*.log
/UnityProject/Logs/

# ---------- Sistema operativo ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
